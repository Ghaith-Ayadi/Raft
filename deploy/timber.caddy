# timber: the app (built and hosted by Vercel) and its PocketBase share one origin.
# /api/* and the dashboard go to PocketBase; everything else is forwarded to the
# Vercel deployment. No serverless routes yet (no uploads).
# Drop into the reverse proxy's sites directory once DNS exists and the
# Vercel alias is timber-ayadi.vercel.app (project "timber").
timber.ayadighaith.com {
	route {
		reverse_proxy /api/* pocketbase-timber:8090
		reverse_proxy /_/* pocketbase-timber:8090
		reverse_proxy https://timber-ayadi.vercel.app {
			header_up Host {upstream_hostport}
		}
	}
}
