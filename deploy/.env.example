# Lives at /srv/raft/.env on the box, mode 600. Never committed. Shape for deploy/docker-compose.yml.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# 32 random characters; encrypts SMTP and S3 secrets stored in PocketBase settings.
PB_ENCRYPTION_KEY=
PB_APP_NAME=Raft
PB_APP_URL=https://raft.ayadighaith.com
# Resend SMTP. Leave empty until the Resend key exists; the bootstrap skips SMTP then.
PB_SMTP_HOST=smtp.resend.com
PB_SMTP_PORT=465
PB_SMTP_USERNAME=resend
PB_SMTP_PASSWORD=
PB_SENDER_ADDRESS=
PB_SENDER_NAME=Raft

# Google sign-in. One OAuth client in Google Cloud Console (Web application) with
# redirect URI https://<host>/api/oauth2-redirect for every PocketBase host.
PB_GOOGLE_CLIENT_ID=
PB_GOOGLE_CLIENT_SECRET=

# Backups to R2 over S3. Derived from the Cloudflare API token: access key = token id,
# secret = sha256(token). Endpoint https://<account-id>.r2.cloudflarestorage.com
PB_S3_ENDPOINT=
PB_S3_BUCKET=bedrock-backups-raft
# Staggered so the apps never upload at the same minute.
PB_BACKUP_CRON=30 3 * * *
PB_S3_ACCESS_KEY=
PB_S3_SECRET=
